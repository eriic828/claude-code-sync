\n            display: block;\n        }\n\n        .power-bar-container {\n            position: absolute;\n            bottom: 30px;\n            left: 50%;\n            transform: translateX(-50%);\n            width: 200px;\n            height: 20px;\n            background: rgba(255, 255, 255, 0.5);\n            border-radius: 10px;\n            overflow: hidden;\n            opacity: 0;\n            transition: opacity 0.3s;\n        }\n\n        .power-bar-container.visible {\n            opacity: 1;\n        }\n\n        .power-bar {\n            height: 100%;\n            width: 0%;\n            background: linear-gradient(90deg, #4CAF50, #FFC107, #f44336);\n            transition: width 0.05s;\n        }\n\n        .game-over {\n            position: absolute;\n            top: 0;\n            left: 0;\n            right: 0;\n            bottom: 0;\n            background: rgba(0, 0, 0, 0.7);\n            display: none;\n            justify-content: center;\n            align-items: center;\n            flex-direction: column;\n            z-index: 200;\n        }\n\n        .game-over.show {\n            display: flex;\n        }\n\n        .game-over-content {\n            background: white;\n            padding: 40px;\n            border-radius: 20px;\n            text-align: center;\n            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);\n        }\n\n        .game-over-title {\n            font-size: 32px;\n            color: #333;\n            margin-bottom: 20px;\n        }\n\n        .final-score {\n            font-size: 48px;\n            color: #667eea;\n            font-weight: bold;\n            margin-bottom: 10px;\n        }\n\n        .final-score-label {\n            font-size: 16px;\n            color: #666;\n            margin-bottom: 30px;\n        }\n\n        .restart-btn {\n            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n            color: white;\n            border: none;\n            padding: 15px 40px;\n            font-size: 18px;\n            border-radius: 30px;\n            cursor: pointer;\n            transition: transform 0.2s, box-shadow 0.2s;\n            box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);\n        }\n\n        .restart-btn:hover {\n            transform: translateY(-2px);\n            box-shadow: 0 6px 20px rgba(102, 126, 234, 0.6);\n        }\n\n        .restart-btn:active {\n            transform: translateY(0);\n        }\n\n        .hint {\n            position: absolute;\n            bottom: 60px;\n            left: 50%;\n            transform: translateX(-50%);\n            color: #666;\n            font-size: 14px;\n            text-align: center;\n            pointer-events: none;\n        }\n    </style>\n</head>\n<body>\n    <div class=\"game-container\">\n        <div class=\"score-board\">\n            <div class=\"score-item\">\n                <div class=\"score-label\">当前得分</div>\n                <div class=\"score-value\" id=\"currentScore\">0</div>\n            </div>\n            <div class=\"score-item\">\n                <div class=\"score-label\">最高得分</div>\n                <div class=\"score-value\" id=\"highScore\">0</div>\n            </div>\n        </div>\n        <canvas id=\"gameCanvas\" width=\"400\" height=\"600\"></canvas>\n        <div class=\"power-bar-container\" id=\"powerBarContainer\">\n            <div class=\"power-bar\" id=\"powerBar\"></div>\n        </div>\n        <div class=\"hint\" id=\"hint\">长按鼠标蓄力，松开跳跃</div>\n        <div class=\"game-over\" id=\"gameOver\">\n            <div class=\"game-over-content\">\n                <div class=\"game-over-title\">游戏结束</div>\n                <div class=\"final-score\" id=\"finalScore\">0</div>\n                <div class=\"final-score-label\">分</div>\n                <button class=\"restart-btn\" id=\"restartBtn\">重新开始</button>\n            </div>\n        </div>\n    </div>\n\n    <script>\n        const canvas = document.getElementById('gameCanvas');\n        const ctx = canvas.getContext('2d');\n        const currentScoreEl = document.getElementById('currentScore');\n        const highScoreEl = document.getElementById('highScore');\n        const powerBarContainer = document.getElementById('powerBarContainer');\n        const powerBar = document.getElementById('powerBar');\n        const gameOverEl = document.getElementById('gameOver');\n        const finalScoreEl = document.getElementById('finalScore');\n        const restartBtn = document.getElementById('restartBtn');\n        const hintEl = document.getElementById('hint');\n\n        let gameState = 'playing';\n        let score = 0;\n        let highScore = localStorage.getItem('jumpGameHighScore') || 0;\n        highScoreEl.textContent = highScore;\n\n        let isCharging = false;\n        let chargeStartTime = 0;\n        let chargePower = 0;\n        const maxChargeTime = 1500;\n\n        const player = {\n            x: 100,\n            y: 300,\n            width: 30,\n            height: 30,\n            vx: 0,\n            vy: 0,\n            isJumping: false,\n            rotation: 0\n        };\n\n        let platforms = [];\n        let cameraOffset = 0;\n\n        const gravity = 0.5;\n        const colors = ['#FF6B6B', '#4ECDC4', '#45B7D1', '#96CEB4', '#FFEAA7', '#DDA0DD', '#98D8C8'];\n\n        function init() {\n            platforms = [];\n            score = 0;\n            currentScoreEl.textContent = score;\n            cameraOffset = 0;\n            gameState = 'playing';\n            gameOverEl.classList.remove('show');\n            hintEl.style.display = 'block';\n\n            platforms.push({\n                x: 50,\n                y: 400,\n                width: 100,\n                height: 80,\n                color: colors[0]\n            });\n\n            player.x = 85;\n            player.y = 370;\n            player.vx = 0;\n            player.vy = 0;\n            player.isJumping = false;\n            player.rotation = 0;\n\n            for (let i = 1; i < 8; i++) {\n                generatePlatform(i);\n            }\n        }\n\n        function generatePlatform(index) {\n            const lastPlatform = platforms[platforms.length - 1];\n            const minGap = 60;\n            const maxGap = 150;\n            const gap = Math.random() * (maxGap - minGap) + minGap;\n\n            const direction = Math.random() > 0.5 ? 1 : -1;\n            const x = lastPlatform.x + direction * gap;\n            const y = lastPlatform.y - Math.random() * 80 - 40;\n\n            const clampedX = Math.max(30, Math.min(canvas.width - 130, x));\n\n            platforms.push({\n                x: clampedX,\n                y: y,\n                width: Math.random() * 40 + 60,\n                height: Math.random() * 30 + 60,\n                color: colors[index % colors.length]\n            });\n        }\n\n        function draw() {\n            ctx.clearRect(0, 0, canvas.width, canvas.height);\n\n            platforms.forEach((platform, index) => {\n                const screenY = platform.y - cameraOffset;\n\n                ctx.fillStyle = 'rgba(0, 0, 0, 0.1)';\n                ctx.fillRect(platform.x + 5, screenY + 5, platform.width, platform.height);\n\n                ctx.fillStyle = platform.color;\n                ctx.fillRect(platform.x, screenY, platform.width, platform.height);\n\n                ctx.fillStyle = 'rgba(255, 255, 255, 0.3)';\n                ctx.fillRect(platform.x, screenY, platform.width, 10);\n            });\n\n            ctx.save();\n            const playerScreenY = player.y - cameraOffset;\n            ctx.translate(player.x + player.width / 2, playerScreenY + player.height / 2);\n            ctx.rotate(player.rotation);\n\n            ctx.fillStyle = 'rgba(0, 0, 0, 0.2)';\n            ctx.fillRect(-player.width / 2 + 3, -player.height / 2 + 3, player.width, player.height);\n\n            ctx.fillStyle = '#2C3E50';\n            ctx.fillRect(-player.width / 2, -player.height / 2, player.width, player.height);\n\n            ctx.fillStyle = '#3498DB';\n            ctx.fillRect(-player.width / 2, -player.height / 2, player.width, 8);\n\n            ctx.fillStyle = 'white';\n            ctx.fillRect(-8, -5, 6, 6);\n            ctx.fillRect(2, -5, 6, 6);\n            ctx.fillStyle = '#2C3E50';\n            ctx.fillRect(-6, -3, 3, 3);\n            ctx.fillRect(4, -3, 3, 3);\n\n            ctx.restore();\n        }\n\n        function update() {\n            if (gameState !== 'playing') return;\n\n            if (isCharging) {\n                const chargeTime = Date.now() - chargeStartTime;\n                chargePower = Math.min(chargeTime / maxChargeTime, 1);\n                powerBar.style.width = (chargePower * 100) + '%';\n            }\n\n            if (player.isJumping) {\n                player.vy += gravity;\n                player.x += player.vx;\n                player.y += player.vy;\n                player.rotation += 0.1;\n\n                for (let i = 0; i < platforms.length; i++) {\n                    const platform = platforms[i];\n                    if (checkCollision(player, platform)) {\n                        if (player.vy > 0) {\n                            player.y = platform.y - player.height;\n                            player.vy = 0;\n                            player.vx = 0;\n                            player.isJumping = false;\n                            player.rotation = 0;\n\n                            if (i > 0 && !platform.scored) {\n                                platform.scored = true;\n                                score++;\n                                currentScoreEl.textContent = score;\n                                hintEl.style.display = 'none';\n\n                                while (platforms.length < i + 8) {\n                                    generatePlatform(platforms.length);\n                                }\n                            }\n                            break;\n                        }\n                    }\n                }\n\n                const targetCameraOffset = player.y - 300;\n                if (targetCameraOffset < cameraOffset - 50) {\n                    cameraOffset += (targetCameraOffset - cameraOffset) * 0.1;\n                }\n\n                if (player.y - cameraOffset > canvas.height + 100) {\n                    gameOver();\n                }\n            }\n        }\n\n        function checkCollision(player, platform) {\n            const playerBottom = player.y + player.height;\n            const playerTop = player.y;\n            const playerLeft = player.x;\n            const playerRight = player.x + player.width;\n\n            const platformTop = platform.y;\n            const platformBottom = platform.y + platform.height;\n            const platformLeft = platform.x;\n            const platformRight = platform.x + platform.width;\n\n            return playerRight > platformLeft &&\n                   playerLeft < platformRight &&\n                   playerBottom >= platformTop &&\n                   playerBottom <= platformTop + 20 &&\n                   player.vy > 0;\n        }\n\n        function jump() {\n            if (player.isJumping || gameState !== 'playing') return;\n\n            const power = chargePower * 15 + 5;\n            const nextPlatform = platforms[1];\n\n            let angle = -Math.PI / 4;\n            if (nextPlatform) {\n                const dx = (nextPlatform.x + nextPlatform.width / 2) - (player.x + player.width / 2);\n                const dy = (nextPlatform.y) - (player.y + player.height);\n                angle = Math.atan2(dy, dx) - 0.3;\n            }\n\n            player.vx = Math.cos(angle) * power * 0.8;\n            player.vy = -power;\n            player.isJumping = true;\n\n            chargePower = 0;\n            powerBar.style.width = '0%';\n            powerBarContainer.classList.remove('visible');\n        }\n\n        function gameOver() {\n            gameState = 'gameover';\n            finalScoreEl.textContent = score;\n\n            if (score > highScore) {\n                highScore = score;\n                localStorage.setItem('jumpGameHighScore', highScore);\n                highScoreEl.textContent = highScore;\n            }\n\n            gameOverEl.classList.add('show');\n        }\n\n        function gameLoop() {\n            update();\n            draw();\n            requestAnimationFrame(gameLoop);\n        }\n\n        canvas.addEventListener('mousedown', (e) => {\n            if (player.isJumping || gameState !== 'playing') return;\n            isCharging = true;\n            chargeStartTime = Date.now();\n            powerBarContainer.classList.add('visible');\n        });\n\n        canvas.addEventListener('mouseup', (e) => {\n            if (!isCharging) return;\n            isCharging = false;\n            jump();\n        });\n\n        canvas.addEventListener('mouseleave', (e) => {\n            if (isCharging) {\n                isCharging = false;\n                jump();\n            }\n        });\n\n        canvas.addEventListener('touchstart', (e) => {\n            e.preventDefault();\n            if (player.isJumping || gameState !== 'playing') return;\n            isCharging = true;\n            chargeStartTime = Date.now();\n            powerBarContainer.classList.add('visible');\n        });\n\n        canvas.addEventListener('touchend', (e) => {\n            e.preventDefault();\n            if (!isCharging) return;\n            isCharging = false;\n            jump();\n        });\n\n        restartBtn.addEventListener('click', init);\n\n        init();\n        gameLoop();\n    </script>\n</body>\n</html>"}}],"model":"doubao-seed-2.0-code","stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":22213,"cache_creation_input_tokens":0,"cache_read_input_tokens":0,"output_tokens":4197,"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0